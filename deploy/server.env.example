# Copy to /etc/marginalia.env, fill in real values, and chmod 600.
EXPERIMENT_WRITER=gemini
GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY

# Optional: leave commented to start with local SQLite.
# TIGER_DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb
# Use DATABASE_URL instead for Vultr PostgreSQL; do not set conflicting URLs.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb
# PGSSLROOTCERT=/opt/marginalia/certs/vultr-ca.pem

# Optional: makes conference web search less dependent on public search pages.
# BRAVE_SEARCH_API_KEY=REPLACE_WITH_YOUR_KEY

SOLANA_NETWORK=mainnet-beta
# SOLANA_RPC_URL=https://YOUR_MAINNET_RPC_ENDPOINT
