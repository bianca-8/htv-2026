# Choose ONE cloud database URL, or leave both unset for local SQLite.
# URL-encode special characters in the username/password.

# Vultr Managed PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@VULTR_HOST:PORT/defaultdb
# Download Vultr's signed CA certificate and use its absolute path.
# PGSSLROOTCERT=/absolute/path/to/certs/vultr-ca.pem

# Tiger Data / Tiger Cloud (use your service's exact hostname and port):
# TIGER_DATABASE_URL=postgresql://tsdbadmin:PASSWORD@SERVICE.PROJECT.tsdb.cloud.timescale.com:PORT/tsdb
# DATABASE_URL also accepts a Tiger Cloud URL. Do not configure different URLs in both.
# Public certificates use the bundled CA trust store automatically.
# If your service requires a custom CA, set PGSSLROOTCERT to its absolute path.

# Local fallback only; ignored when either cloud URL is set.
# MARGINALIA_DB=.cache/research.sqlite3
